# Optional. When set, the deployed frontend calls this API origin instead of
# the same-origin "/api" (used in dev via the Vite proxy, see vite.config.ts).
VITE_API_BASE_URL=

# Required for the Kakao login button (pages/LoginPage.tsx) to build the
# correct Kakao authorize URL. Must be the same app's "REST API 키" and one
# of its registered "Redirect URI"s as the backend's KAKAO_CLIENT_ID /
# KAKAO_REDIRECT_URI (see backend/.env.example).
VITE_KAKAO_CLIENT_ID=
VITE_KAKAO_REDIRECT_URI=http://localhost:5173/auth/kakao/callback
