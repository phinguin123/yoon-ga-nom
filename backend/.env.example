NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Required for YouTube upload dates on DOTY drips and live stats on the type-challenge archive.
# Get a key at https://console.cloud.google.com/apis/credentials
# (enable "YouTube Data API v3" on the project first).
YOUTUBE_API_KEY=

# Required for the /admin dashboard (adding/editing/deleting episodes).
# Generate ADMIN_PASSWORD_HASH with: npm run hash-password -- "your-password"
# Generate JWT_SECRET with:          openssl rand -hex 32
ADMIN_PASSWORD_HASH=
JWT_SECRET=

# Required for fan Kakao login (POST /api/auth/kakao).
# Create an app at https://developers.kakao.com/console/app, then:
#   - KAKAO_CLIENT_ID: the app's "REST API 키"
#   - KAKAO_CLIENT_SECRET: only needed if "Client Secret" is enabled for the app
#   - KAKAO_REDIRECT_URI: must exactly match a "Redirect URI" registered under
#     Kakao Login settings, e.g. http://localhost:5173/auth/kakao/callback
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:5173/auth/kakao/callback
# Primary Admin Key (앱 > 앱 키 > 대표 Admin 키). Kakao sends this in the
# Authorization header of unlink webhooks as `KakaoAK ${KAKAO_ADMIN_KEY}`.
KAKAO_ADMIN_KEY=

# Signs the custom session JWTs issued after a Kakao login succeeds. We
# never store or reuse Kakao's own tokens for sessions — only these.
# Generate both with: openssl rand -hex 32 (use two DIFFERENT values)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=2h
REFRESH_TOKEN_TTL=14d
