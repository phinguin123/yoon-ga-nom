NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Optional. When set, live view counts/durations/thumbnails/titles are
# pulled from the YouTube Data API v3 for the videos in
# src/data/typeChallengeVideos.ts. Without it, the app falls back to the
# placeholder values in that file — no crash, just static demo numbers.
# Get a key at https://console.cloud.google.com/apis/credentials
# (enable "YouTube Data API v3" on the project first).
YOUTUBE_API_KEY=
